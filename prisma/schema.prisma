generator client {
  provider = "prisma-client-js"
  // output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  accountId     String   @unique
  password     String
  role         Role
  institution  String
}

enum Role {
  ADMIN
  USER
}

model PatientData {
  id String @unique @default(uuid())
  isReceived String
  patientId String @unique @default(uuid())
  patientName String 
  isMale  String 
  birthday String 
  operationDate String
  institution String?
  group String?
  droped Boolean? @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model NeoY {
  id Int @id @default(autoincrement())
  serialNum String 
  Neo String
  group String
}
model NeoN {
  id Int @id @default(autoincrement())
  serialNum String 
  Neo String
  group String
}